# Dependencies and build output (recreated with: npm install && npm run build)
node_modules/
dist/

# Secrets and local environment files: never commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Tool caches and local agent/editor state
.impeccable/hook.cache.json
.claude/
.vscode/
.idea/

# QA screenshots: large and regenerated on demand
docs/screenshots/

# Logs and OS files
*.log
npm-debug.log*
Thumbs.db
Desktop.ini
.DS_Store
